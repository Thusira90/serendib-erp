# React 19 RC is still peer-dep-shy: several UI libraries (react-day-picker,
# react-remove-scroll, and a couple of Radix packages) pin React ^18.
# Locally we always install with --legacy-peer-deps; Vercel and any CI
# runner need the same behavior as a repo-level default, otherwise
# `npm ci` fails with ERESOLVE before the build even starts.
legacy-peer-deps=true
