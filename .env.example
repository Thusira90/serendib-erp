# Database
# Default: SQLite (zero-setup, single-file DB under prisma/dev.db).
# To switch to Postgres later, update the DATABASE_URL and change
# `datasource db { provider = "sqlite" }` to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# NextAuth v5 — generate a real value with:  openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_NAME="Serendib Gemstones ERP"
NEXT_PUBLIC_APP_ID_PREFIX="SGS"

# Cloudflare R2 media storage (optional — if unset, uploads fall back to
# public/uploads/ on the server's local disk, which is fine for dev but
# won't persist across Vercel deploys or scale to many photos).
# Create a bucket in dash.cloudflare.com → R2, enable the Public
# Development URL, then create an R2 API Token with Object R/W permissions
# scoped to that bucket. Copy the S3-compatible credentials (NOT the
# cfut_... user token — that's a different kind of key).
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="serendib-media"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
