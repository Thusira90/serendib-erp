# Database
# Default: SQLite (zero-setup, single-file DB under prisma/dev.db).
# To switch to Postgres later, update the DATABASE_URL and change
# `datasource db { provider = "sqlite" }` to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# NextAuth v5 — generate a real value with:  openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# App
NEXT_PUBLIC_APP_NAME="Serendib Gemstones ERP"
NEXT_PUBLIC_APP_ID_PREFIX="SGS"
