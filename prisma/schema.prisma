// Serendib Gemstones ERP — Milestone 1 schema.
// Every gemstone (rough and finished) has a permanent unique ID.
// Finished gemstones link back to their parent rough(s) through
// GemstoneTransformation records, which support 1:1, 1:many and many:1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres in production and dev. DATABASE_URL points at the transaction
  // pooler (Supavisor 6543) for the app runtime; DIRECT_URL uses the
  // session-mode pooler (5432) for migrations, which are incompatible with
  // pgbouncer transaction mode. In CI or local runs without Supabase, both
  // env vars can point at any Postgres instance (or a local docker-compose).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & RBAC ────────────────────────────────────────────────────────────



model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role  String  @default("SALES")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cuttingJobs   CuttingJob[]  @relation("CutterJobs")
  auditEntries  AuditLog[]
  notifications Notification[]
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  country     String?
  city        String?
  contact     String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parcels     Parcel[]
  roughStones RoughStone[]
}

// ─── Parcels (a purchase of many rough stones together) ──────────────────────

model Parcel {
  id            String   @id @default(cuid())
  code          String   @unique          // PARCEL-2026-0045
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  purchaseDate  DateTime
  origin        String?
  totalWeightCt Decimal
  totalCost     Decimal
  currency      String   @default("LKR")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roughStones   RoughStone[]
}

// ─── Rough stones ────────────────────────────────────────────────────────────



model RoughStone {
  id             String        @id @default(cuid())
  code           String        @unique        // SGS-R-2026-000147
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  parcelId       String?
  parcel         Parcel?       @relation(fields: [parcelId], references: [id])
  locationId     String?
  location       InventoryLocation? @relation(fields: [locationId], references: [id])

  purchaseDate   DateTime
  gemType        String                          // "Sapphire", "Spinel", "Garnet", ...
  variety        String?                         // "Blue Sapphire", "Padparadscha", ...
  species        String?
  origin         String?                         // "Sri Lanka", "Mogok", ...
  mineSource     String?

  weightCt       Decimal
  lengthMm       Decimal?
  widthMm        Decimal?
  heightMm       Decimal?
  shape          String?
  color          String?
  transparency   String?
  clarity        String?
  inclusions     String?
  surface        String?
  fractures      String?
  observations   String?

  purchasePrice  Decimal
  currency       String   @default("LKR")
  pricePerCt     Decimal?

  initialValuation Decimal?
  valuationBy    String?
  valuationDate  DateTime?
  valuationNotes String?

  status  String  @default("PURCHASED")

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Genealogy: transformation records where this rough is an input
  transformationsAsInput TransformationInput[]

  // Cutting
  cuttingPlans  CuttingPlan[]
  cuttingJobs   CuttingJob[]

  // Media
  digitalAssets DigitalAsset[]
}

// ─── Finished gemstones ──────────────────────────────────────────────────────



model Gemstone {
  id             String    @id @default(cuid())
  code           String    @unique          // SGS-G-2026-000381
  locationId     String?
  location       InventoryLocation? @relation(fields: [locationId], references: [id])

  gemType        String
  variety        String?
  species        String?
  origin         String?
  treatment      String?
  treatmentStatus String?

  weightCt       Decimal
  lengthMm       Decimal?
  widthMm        Decimal?
  depthMm        Decimal?
  shape          String?
  cut            String?
  facetingStyle  String?

  colorHue       String?
  colorTone      String?
  colorSaturation String?
  colorDescription String?
  clarity        String?
  transparency   String?
  luster         String?
  fluorescence   String?
  inclusions     String?
  symmetry       String?
  polish         String?

  // Cost rollup (computed at write-time from allocated costs).
  totalCost      Decimal @default(0)
  costPerCt      Decimal @default(0)
  currency       String   @default("LKR")

  askingPrice    Decimal?
  minimumPrice   Decimal?
  pricePerCt     Decimal?

  status  String  @default("IN_PROGRESS")

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Genealogy: transformation records where this gemstone is an output
  transformationsAsOutput TransformationOutput[]

  // Cost allocations (parent-cost + operational-cost lines allocated to this stone)
  costAllocations CostAllocation[]

  // Price history
  priceHistory   PriceHistory[]

  // Certification, CGI, digital assets
  certificates   Certificate[]
  cgiProjects    CGIProject[]
  digitalAssets  DigitalAsset[]

  // Sales pipeline
  enquiries      Enquiry[]
  quotations     Quotation[]
  reservations   Reservation[]
  salesOrders    SalesOrder[]

  // Collections (curated share bundles for customers)
  collectionItems CollectionItem[]
}

// ─── Gemstone transformations (the genealogy engine) ─────────────────────────
// One transformation record represents a lapidary or splitting event where
// one or more input rough stones become one or more output finished stones,
// with a measured yield and loss.



model GemstoneTransformation {
  id           String   @id @default(cuid())
  code         String   @unique              // TX-2026-00127
  type  String  @default("CUTTING")
  performedAt  DateTime
  operator     String?
  cost         Decimal @default(0)
  currency     String   @default("LKR")
  notes        String?

  cuttingJobId String?  @unique
  cuttingJob   CuttingJob? @relation(fields: [cuttingJobId], references: [id])

  inputs       TransformationInput[]
  outputs      TransformationOutput[]

  // Denormalized totals for reporting.
  totalInputWeightCt  Decimal @default(0)
  totalOutputWeightCt Decimal @default(0)
  wasteWeightCt       Decimal @default(0)
  yieldPct            Decimal @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TransformationInput {
  id               String   @id @default(cuid())
  transformationId String
  transformation   GemstoneTransformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  roughStoneId     String
  roughStone       RoughStone @relation(fields: [roughStoneId], references: [id])
  inputWeightCt    Decimal
  inputCost        Decimal @default(0)

  @@unique([transformationId, roughStoneId])
}

model TransformationOutput {
  id               String   @id @default(cuid())
  transformationId String
  transformation   GemstoneTransformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)
  gemstoneId       String
  gemstone         Gemstone @relation(fields: [gemstoneId], references: [id])
  outputWeightCt   Decimal
  allocatedCost    Decimal @default(0)

  @@unique([transformationId, gemstoneId])
}

// ─── Cutting ─────────────────────────────────────────────────────────────────



model CuttingPlan {
  id            String   @id @default(cuid())
  roughStoneId  String
  roughStone    RoughStone @relation(fields: [roughStoneId], references: [id])
  name          String    // "Plan A", "Plan B"
  proposedShape String?
  proposedLengthMm Decimal?
  proposedWidthMm  Decimal?
  proposedDepthMm  Decimal?
  expectedWeightCt Decimal?
  expectedYieldPct Decimal?
  expectedValue    Decimal?
  cutterRecommendation String?
  riskAssessment String?
  notes         String?
  selected      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CuttingJob {
  id            String   @id @default(cuid())
  code          String   @unique              // CJ-2026-00127
  roughStoneId  String
  roughStone    RoughStone @relation(fields: [roughStoneId], references: [id])
  cutterId      String?
  cutter        User?    @relation("CutterJobs", fields: [cutterId], references: [id])

  startedAt     DateTime?
  expectedCompletion DateTime?
  completedAt   DateTime?

  plannedCut    String?
  actualCut     String?
  targetWeightCt Decimal?
  expectedYieldPct Decimal?
  actualYieldPct   Decimal?

  cuttingCost   Decimal @default(0)
  laborCost     Decimal @default(0)
  machineCost   Decimal @default(0)
  currency      String   @default("LKR")

  notes         String?
  status  String  @default("PENDING")

  transformation GemstoneTransformation?

  // Process media (photos/videos of the cutting session itself)
  digitalAssets  DigitalAsset[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Inventory locations (hierarchical) ──────────────────────────────────────

model InventoryLocation {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  parentId   String?
  parent     InventoryLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children   InventoryLocation[] @relation("LocationTree")

  roughStones RoughStone[]
  gemstones   Gemstone[]
  movements   InventoryMovement[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}



model InventoryMovement {
  id           String   @id @default(cuid())
  itemKind  String
  roughStoneId String?
  gemstoneId   String?
  toLocationId String
  toLocation   InventoryLocation @relation(fields: [toLocationId], references: [id])
  fromLocationId String?
  movedById    String?
  movedByName  String?
  reason       String?
  movedAt      DateTime @default(now())
}

// ─── Cost allocations (feeds true-cost rollup) ───────────────────────────────



model CostAllocation {
  id           String   @id @default(cuid())
  gemstoneId   String
  gemstone     Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  type  String
  description  String?
  amount       Decimal
  currency     String   @default("LKR")
  incurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ─── Price history (never overwritten) ───────────────────────────────────────

model PriceHistory {
  id           String   @id @default(cuid())
  gemstoneId   String
  gemstone     Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  oldPrice     Decimal?
  newPrice     Decimal
  currency     String   @default("LKR")
  reason       String?
  changedBy    String?
  changedAt    DateTime @default(now())
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userName     String?
  entity       String            // "RoughStone", "Gemstone", ...
  entityId     String
  entityCode   String?           // "SGS-R-2026-000147"
  action       String            // "CREATE", "UPDATE", "STATUS_CHANGE", "PRICE_CHANGE", ...
  field        String?           // when a single field changed
  oldValue     String?
  newValue     String?
  metadata     String?
  ipAddress    String?

  @@index([entity, entityId])
  @@index([at])
}

// ─── ID sequence helper ──────────────────────────────────────────────────────
// Serial counter per (prefix, year) so we can mint SGS-R-2026-000147 style IDs
// deterministically inside a transaction without a race.

model IdSequence {
  id        String @id @default(cuid())
  prefix    String            // "SGS-R", "SGS-G", "PARCEL", "CJ", "TX", "CGI", "CERT"
  year      Int
  lastValue Int    @default(0)

  @@unique([prefix, year])
}

// ─── Certification ───────────────────────────────────────────────────────────

model Laboratory {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  country  String?
  website  String?
  notes    String?
  createdAt DateTime @default(now())

  certificates Certificate[]
}





model Certificate {
  id                    String   @id @default(cuid())
  code                  String   @unique         // CERT-2026-00042 (internal)
  gemstoneId            String
  gemstone              Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  laboratoryId          String
  laboratory            Laboratory @relation(fields: [laboratoryId], references: [id])
  certificateNumber     String?                  // lab-issued number
  type  String  @default("IDENTIFICATION")
  status  String  @default("NOT_SUBMITTED")

  submissionDate        DateTime?
  returnDate            DateTime?
  issueDate             DateTime?

  originDetermination   String?
  treatmentDetermination String?
  weightCt              Decimal?
  dimensions            String?
  colorGrade            String?
  comments              String?

  laboratoryFees        Decimal?
  currency              String   @default("LKR")

  documentUrl           String?                  // path or URL to PDF
  imageUrl              String?                  // path or URL to scan image

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([gemstoneId])
}

// ─── CGI ─────────────────────────────────────────────────────────────────────



model CGIProject {
  id            String   @id @default(cuid())
  code          String   @unique              // CGI-2026-00482
  gemstoneId    String
  gemstone      Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  artist        String?
  software      String?
  softwareVersion String?
  status  String  @default("REQUESTED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions      CGIVersion[]

  @@index([gemstoneId])
}

model CGIVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     CGIProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  code        String   @unique                // CGI-2026-00482-V1
  isMaster    Boolean  @default(false)
  approvedAt  DateTime?
  approvedBy  String?

  renderUrl   String?
  modelUrl    String?
  animationUrl String?
  thumbnailUrl String?

  notes       String?
  createdAt   DateTime @default(now())

  @@unique([projectId, version])
}

// ─── Digital assets (photos, videos, media) ──────────────────────────────────



model DigitalAsset {
  id            String   @id @default(cuid())
  gemstoneId    String?
  gemstone      Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  roughStoneId  String?
  roughStone    RoughStone? @relation(fields: [roughStoneId], references: [id], onDelete: Cascade)
  cuttingJobId  String?
  cuttingJob    CuttingJob? @relation(fields: [cuttingJobId], references: [id], onDelete: Cascade)
  kind  String
  // Lifecycle stage the media was captured at: ROUGH_INTAKE, PLANNING,
  // PRE_CUT, CUTTING, POLISHING, FINAL, INSPECTION, PACKAGING, OTHER.
  // Orthogonal to `kind` (photo/video/document).
  stage  String?
  url           String
  contentType   String?
  originalName  String?
  caption       String?
  isPrimary     Boolean  @default(false)
  // When the media was actually TAKEN (may differ from createdAt = upload
  // time). Falls back to createdAt when not supplied — used for
  // chronological ordering across the full stone lifecycle timeline.
  capturedAt    DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([gemstoneId])
  @@index([roughStoneId])
  @@index([cuttingJobId])
}

// ─── Customers (CRM) ─────────────────────────────────────────────────────────





model Customer {
  id            String   @id @default(cuid())
  code          String   @unique              // CUST-2026-0012
  kind  String  @default("INDIVIDUAL")
  type  String  @default("PRIVATE_BUYER")
  displayName   String                        // "James Chen" or "Maison Aurel"
  companyName   String?
  country       String?
  city          String?
  addressLine   String?
  email         String?
  phone         String?
  website       String?
  socialProfile String?
  notes         String?

  // Free-form preferences — matches the JSON shape defined in
  // src/lib/customer-preferences.ts (types, colors, shapes, size / budget bands).
  preferences   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries     Enquiry[]
  quotations    Quotation[]
  reservations  Reservation[]
  salesOrders   SalesOrder[]
  payments      Payment[]

  // Curated Collections we've built for or shared with this customer.
  collections   Collection[]

  @@index([displayName])
}

// ─── Collections (curated share bundles) ─────────────────────────────────────
// A Collection is a saved bundle of gemstones with a public share URL. Used
// to send a customer a hand-picked shortlist ("here are 6 sapphires for you")
// or to publish current stock under a memorable link. Every collection has:
//   - a short unambiguous shareCode used in the public URL (/share/<code>)
//   - optional expiry and password (hashed) for time-boxed/private sharing
//   - view counters so sales can see engagement without extra infra

model Collection {
  id            String   @id @default(cuid())
  code          String   @unique              // COL-2026-0007 — internal
  shareCode     String   @unique              // K7XR2P — used in public URL
  name          String
  intro         String?                       // shown at top of share page

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])

  createdById   String?
  createdByName String?                       // denormalized: preserved on user delete

  expiresAt     DateTime?
  passwordHash  String?
  isArchived    Boolean  @default(false)

  viewCount     Int      @default(0)
  lastViewedAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         CollectionItem[]

  @@index([shareCode])
  @@index([customerId])
}

model CollectionItem {
  id             String   @id @default(cuid())
  collectionId   String
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  gemstoneId     String
  gemstone       Gemstone @relation(fields: [gemstoneId], references: [id])

  displayOrder   Int      @default(0)
  priceOverride  Decimal?
  currency       String?                       // populated only when priceOverride is set
  note           String?                       // free-text note to the customer

  createdAt      DateTime @default(now())

  @@unique([collectionId, gemstoneId])
  @@index([gemstoneId])
}

// ─── Enquiries ───────────────────────────────────────────────────────────────



model Enquiry {
  id            String   @id @default(cuid())
  code          String   @unique              // ENQ-2026-0007
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  gemstoneId    String?
  gemstone      Gemstone? @relation(fields: [gemstoneId], references: [id])

  requirement   String                        // free-text "3-5ct unheated Ceylon blue…"
  preferredOrigin    String?
  preferredTreatment String?
  preferredShape     String?
  minWeightCt   Decimal?
  maxWeightCt   Decimal?
  budgetMin     Decimal?
  budgetMax     Decimal?
  currency      String   @default("LKR")
  quantity      Int      @default(1)

  salespersonId String?
  followUpDate  DateTime?
  status  String  @default("NEW")
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations    Quotation[]

  @@index([customerId])
  @@index([gemstoneId])
}

// ─── Quotations ──────────────────────────────────────────────────────────────



model Quotation {
  id            String   @id @default(cuid())
  code          String   @unique              // Q-2026-0021
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  gemstoneId    String
  gemstone      Gemstone @relation(fields: [gemstoneId], references: [id])
  enquiryId     String?
  enquiry       Enquiry? @relation(fields: [enquiryId], references: [id])

  price         Decimal
  currency      String   @default("LKR")
  validUntil    DateTime?
  paymentTerms  String?
  deliveryTerms String?
  shippingTerms String?
  notes         String?

  status  String  @default("DRAFT")
  sentAt        DateTime?
  respondedAt   DateTime?

  salespersonId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([gemstoneId])
}

// ─── Reservations ────────────────────────────────────────────────────────────



model Reservation {
  id            String   @id @default(cuid())
  code          String   @unique              // RES-2026-0011
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  gemstoneId    String
  gemstone      Gemstone @relation(fields: [gemstoneId], references: [id])
  quotationId   String?

  price         Decimal
  deposit       Decimal?
  currency      String   @default("LKR")
  reservedAt    DateTime @default(now())
  expiresAt     DateTime?
  releasedAt    DateTime?
  releasedReason String?

  salespersonId String?
  status  String  @default("ACTIVE")
  notes         String?

  // Prevents two ACTIVE reservations for the same gemstone at the same time.
  // Enforced via partial unique index in a follow-up migration; the app-level
  // transaction in reserveGemstone also asserts this.

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([gemstoneId, status])
  @@index([customerId])
}

// ─── Sales orders ────────────────────────────────────────────────────────────



model SalesOrder {
  id             String   @id @default(cuid())
  code           String   @unique             // SO-2026-0007
  invoiceNumber  String   @unique             // INV-2026-0007
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  gemstoneId     String
  gemstone       Gemstone @relation(fields: [gemstoneId], references: [id])
  quotationId    String?
  reservationId  String?

  agreedPrice    Decimal
  currency       String   @default("LKR")
  taxAmount      Decimal @default(0)
  totalAmount    Decimal   // agreedPrice + taxAmount

  saleDate       DateTime @default(now())
  salespersonId  String?
  notes          String?
  status  String  @default("CONFIRMED")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments       Payment[]
  shipment       Shipment?

  @@index([customerId])
  @@index([gemstoneId])
}

// ─── Payments ────────────────────────────────────────────────────────────────



model Payment {
  id            String   @id @default(cuid())
  code          String   @unique              // PAY-2026-0031
  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  amount        Decimal
  currency      String   @default("LKR")
  method  String  @default("BANK_TRANSFER")
  reference     String?
  receivedAt    DateTime @default(now())
  notes         String?
  recordedBy    String?

  createdAt     DateTime @default(now())

  @@index([salesOrderId])
  @@index([customerId])
}

// ─── Shipments (export / delivery) ───────────────────────────────────────────



model Shipment {
  id             String   @id @default(cuid())
  code           String   @unique             // SHP-2026-0011
  salesOrderId   String   @unique             // one shipment per sales order in this milestone
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])

  courier        String?
  trackingNumber String?
  destination    String?
  destCountry    String?

  shippingCost   Decimal?
  insuranceCost  Decimal?
  declaredValue  Decimal?
  currency       String   @default("LKR")

  preparedAt     DateTime?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  commercialInvoiceUrl String?
  packingListUrl       String?
  customsUrl           String?

  notes          String?
  status  String  @default("PREPARING")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([salesOrderId])
}

// ─── Notifications ───────────────────────────────────────────────────────────



model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type  String
  title       String
  body        String?
  entity      String?
  entityId    String?
  entityCode  String?
  url         String?
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ─── Expenses (first-class general expenses, separate from per-stone allocations) ─

model Expense {
  id            String   @id @default(cuid())
  code          String   @unique             // EXP-2026-0031
  category      String                       // ExpenseCategory (see src/lib/enums.ts)
  amount        Decimal
  currency      String   @default("LKR")
  vendor        String?
  description   String
  incurredAt    DateTime @default(now())

  // Optional link to a business entity — an expense may be for a specific
  // gemstone, rough, cutting job, customer engagement, or shipment; or just
  // general (no link).
  relatedEntity String?                      // "Gemstone" | "RoughStone" | "CuttingJob" | "Customer" | "Shipment"
  relatedId     String?
  relatedCode   String?

  receiptUrl    String?
  status        String   @default("RECORDED") // ExpenseStatus
  recordedBy    String?
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([incurredAt])
  @@index([relatedEntity, relatedId])
}

// ─── Company settings (singleton — id = "singleton") ────────────────────────

model CompanySettings {
  id                 String   @id @default("singleton")
  legalName          String   @default("Serendib Gemstones (Pvt) Ltd")
  tradingName        String?
  addressLine        String?
  city               String?
  country            String   @default("Sri Lanka")
  taxId              String?
  registrationNumber String?
  email              String?
  phone              String?
  website            String?

  defaultCurrency    String   @default("LKR")
  defaultPaymentTerms  String @default("50% on order, 50% before shipping")
  defaultDeliveryTerms String @default("Insured courier, 5–7 business days")
  defaultShippingTerms String @default("DAP customer address")

  updatedAt          DateTime @updatedAt
}

// ─── Directors, Shareholders, Share register, Capital ledger ────────────────
// Modelled after the SGS ERP architecture spec §16–21:
//   * Director  — person holding a board seat. Ownership (share %) is DERIVED
//     from the share register, never stored on the Director row.
//   * Shareholder — person or entity that holds shares. May optionally point
//     to a Director row when the same person plays both roles.
//   * ShareClass — issued share class (ORD, PREF, …) with face value.
//   * ShareTransaction — append-only ledger of share ISSUE / TRANSFER /
//     CANCEL events. The historical register must remain reconstructable
//     from this table alone; ShareLot is a materialised current-state cache.
//   * ShareLot — denormalised "current holdings" per (shareholder, class),
//     recomputed inside the same transaction that writes ShareTransaction.
//   * CapitalTransaction — every money movement between the company and a
//     director/shareholder. `type` distinguishes SHARE_CAPITAL from
//     DIRECTOR_LOAN, ADVANCE, EXPENSE_PAID_ON_BEHALF, WITHDRAWAL,
//     LOAN_REPAY, ADVANCE_REPAY, DIVIDEND — so the capital ledger can
//     be rolled up by category without ambiguity. `status` (DRAFT/POSTED/
//     REVERSED) is the hook the accounting engine will use in Phase 2 to
//     enforce immutability of posted entries and to wire in the GL.

model Director {
  id            String   @id @default(cuid())
  code          String   @unique              // DIR-0001 — global, year-less counter
  name          String
  role          String   @default("Director") // "Chairman", "Managing Director", ...
  email         String?
  phone         String?
  nationalId    String?
  address       String?
  active        Boolean  @default(true)
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shareholder   Shareholder?
  capitalTransactions CapitalTransaction[]

  @@index([active])
}

model Shareholder {
  id            String   @id @default(cuid())
  code          String   @unique              // SH-0001 — global, year-less counter
  kind          String   @default("INDIVIDUAL") // INDIVIDUAL | ENTITY
  name          String
  email         String?
  phone         String?
  nationalId    String?                       // NIC / passport / company reg number
  address       String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  directorId    String?  @unique              // 1:0..1 back-link when same person holds a board seat
  director      Director? @relation(fields: [directorId], references: [id])

  lots                ShareLot[]
  transactionsFrom    ShareTransaction[]      @relation("ShareTransferor")
  transactionsTo      ShareTransaction[]      @relation("ShareTransferee")
  capitalTransactions CapitalTransaction[]

  @@index([active])
}

model ShareClass {
  id            String   @id @default(cuid())
  code          String   @unique              // "ORD", "PREF"
  name          String                        // "Ordinary shares"
  faceValue     Decimal                       // per share
  currency      String   @default("LKR")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lots          ShareLot[]
  transactions  ShareTransaction[]
}

model ShareLot {
  id            String   @id @default(cuid())
  shareholderId String
  shareholder   Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  shareClassId  String
  shareClass    ShareClass  @relation(fields: [shareClassId], references: [id])
  numberOfShares Decimal   @default(0)        // current holding, updated by ShareTransaction
  paidUpAmount   Decimal   @default(0)        // total paid-in for this holding
  updatedAt     DateTime  @updatedAt

  @@unique([shareholderId, shareClassId])
  @@index([shareholderId])
}

model ShareTransaction {
  id            String   @id @default(cuid())
  code          String   @unique              // ST-2026-0001
  type          String                        // SHARE_ISSUE | SHARE_TRANSFER | SHARE_CANCEL
  shareClassId  String
  shareClass    ShareClass @relation(fields: [shareClassId], references: [id])
  numberOfShares Decimal
  pricePerShare  Decimal                      // price paid or transfer value per share
  totalAmount    Decimal                      // numberOfShares * pricePerShare
  currency       String   @default("LKR")

  transferorId  String?                       // Shareholder losing shares — null for ISSUE
  transferor    Shareholder? @relation("ShareTransferor", fields: [transferorId], references: [id])
  transfereeId  String?                       // Shareholder gaining shares — null for CANCEL
  transferee    Shareholder? @relation("ShareTransferee", fields: [transfereeId], references: [id])

  transactionDate DateTime @default(now())
  reference       String?                     // board resolution, transfer form ref, …
  documentUrl     String?
  notes           String?
  recordedBy      String?
  createdAt       DateTime @default(now())

  // When the paired capital transaction (SHARE_CAPITAL for an ISSUE) exists,
  // this back-link makes the audit trail navigable in both directions.
  capitalTransactionId String? @unique
  capitalTransaction   CapitalTransaction? @relation(fields: [capitalTransactionId], references: [id])

  @@index([transactionDate])
  @@index([shareClassId])
}

model CapitalTransaction {
  id            String   @id @default(cuid())
  code          String   @unique              // CT-2026-0001
  type          String                        // SHARE_CAPITAL | DIRECTOR_LOAN | LOAN_REPAY | ADVANCE | ADVANCE_REPAY | EXPENSE_PAID_ON_BEHALF | WITHDRAWAL | DIVIDEND

  // Exactly one of these is set depending on `type`. Enforced in the action layer.
  directorId    String?
  director      Director? @relation(fields: [directorId], references: [id])
  shareholderId String?
  shareholder   Shareholder? @relation(fields: [shareholderId], references: [id])

  amount        Decimal
  currency      String   @default("LKR")
  method        String   @default("BANK_TRANSFER") // PaymentMethod values reused
  reference     String?
  transactionDate DateTime @default(now())
  receiptUrl    String?
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())

  // Posting lifecycle — DRAFT while under review, POSTED once accepted,
  // REVERSED after a reversing entry. Once POSTED, edits are refused; the
  // only allowed change is REVERSAL via a paired CapitalTransaction.
  status        String   @default("POSTED")   // DRAFT | POSTED | REVERSED
  postedAt      DateTime?
  postedBy      String?
  reversalOfId  String?  @unique              // this row IS the reversal of that row
  reversalOf    CapitalTransaction? @relation("CapitalReversal", fields: [reversalOfId], references: [id])
  reversedBy    CapitalTransaction? @relation("CapitalReversal")

  // For type=SHARE_CAPITAL, we create a matching ShareTransaction; this
  // hard-link is the audit thread between money-in and shares-out.
  shareTransaction ShareTransaction?

  // Populated after this CapitalTransaction has been auto-posted to the GL.
  // Foreign-currency entries are not auto-posted yet, so this stays null
  // for them until an FX policy exists.
  journalId String?  @unique
  journal   Journal? @relation(fields: [journalId], references: [id])

  @@index([directorId, transactionDate])
  @@index([shareholderId, transactionDate])
  @@index([type])
}

// ─── Chart of Accounts + Double-entry engine ────────────────────────────────
// Foundation for the SGS ERP financial architecture (spec §9–15, §22, §24).
//
//   * ChartAccount  — nodes in the CoA tree. `type` is one of the five
//     accounting categories; `subtype` is a system tag that lets the app
//     look up the "the bank account", "the director loans account", etc.
//     without hard-coding IDs. `isSystem` = seeded, immovable.
//   * AccountingPeriod — one row per (year, month). Status OPEN → CLOSED
//     → LOCKED. Closed periods refuse new POSTED journals; corrections
//     use reversing entries in the current period.
//   * Journal — a single balanced transaction. Debits ALWAYS equal
//     credits (enforced in the action layer, checked with a totalAmount
//     column here for fast rollups). `status` mirrors CapitalTransaction:
//     POSTED and REVERSED entries stay in the ledger forever. `sourceModule`
//     + `sourceId` link the journal back to whichever module posted it
//     (CAPITAL for CapitalTransaction, MANUAL for hand-entered, EXPENSE /
//     SALE / PAYMENT for future retrofits) so drill-through works both
//     directions.
//   * JournalLine — one row per debit or credit entry.

model ChartAccount {
  id            String   @id @default(cuid())
  code          String   @unique              // "1100", "2200", …
  name          String
  type          String                        // ASSET | LIABILITY | EQUITY | REVENUE | COST_OF_SALES | EXPENSE
  subtype       String?                       // BANK | CASH | AR | AP | INVENTORY_ROUGH | INVENTORY_GEMSTONE | DIRECTOR_LOAN | SHARE_CAPITAL | RETAINED_EARNINGS | REVENUE_SALES | COS_GEMSTONE | ...
  parentId      String?
  parent        ChartAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children      ChartAccount[] @relation("AccountTree")
  currency      String   @default("LKR")
  isActive      Boolean  @default(true)
  isSystem      Boolean  @default(false)      // seeded accounts can't be renamed/deleted
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journalLines  JournalLine[]

  @@index([type])
  @@index([subtype])
  @@index([parentId])
}

model AccountingPeriod {
  id            String   @id @default(cuid())
  year          Int
  month         Int                            // 1..12
  status        String   @default("OPEN")      // OPEN | CLOSED | LOCKED
  closedAt      DateTime?
  closedBy      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journals      Journal[]

  @@unique([year, month])
  @@index([status])
}

model Journal {
  id            String   @id @default(cuid())
  code          String   @unique              // JE-2026-0001
  transactionDate DateTime
  periodId      String
  period        AccountingPeriod @relation(fields: [periodId], references: [id])
  description   String
  reference     String?
  currency      String   @default("LKR")

  // Provenance — which module posted this entry?
  sourceModule  String   @default("MANUAL")   // MANUAL | CAPITAL | EXPENSE | SALE | PAYMENT | ...
  sourceId      String?                       // source record id
  sourceCode    String?                       // source record code

  status        String   @default("POSTED")   // DRAFT | POSTED | REVERSED
  postedAt      DateTime?
  postedBy      String?
  reversalOfId  String?  @unique
  reversalOf    Journal? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy    Journal? @relation("JournalReversal")

  totalAmount   Decimal                       // sum of debits (== sum of credits)

  lines               JournalLine[]
  capitalTransaction  CapitalTransaction?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([transactionDate])
  @@index([periodId])
  @@index([sourceModule, sourceId])
  @@index([status])
}

model JournalLine {
  id            String   @id @default(cuid())
  journalId     String
  journal       Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId     String
  account       ChartAccount @relation(fields: [accountId], references: [id])
  debit         Decimal  @default(0)
  credit        Decimal  @default(0)
  description   String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([journalId])
  @@index([accountId])
}

// ─── Cross-entity comments ──────────────────────────────────────────────────

model Comment {
  id         String   @id @default(cuid())
  entity     String                       // "Gemstone" | "RoughStone" | "Customer" | "CuttingJob" | "SalesOrder" | "Enquiry"
  entityId   String
  entityCode String?
  text       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
}
